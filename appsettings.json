{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=<Server>;database=<Database>;User=<User>;pwd=<Password>;TrustServerCertificate=True;"
  },
  "LockSettings": {
    "ExpirationMinutes": 15
  }
}